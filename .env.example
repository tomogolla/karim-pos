# Karim POS - PRODUCTION environment template.
# Copy to .env on the server, replace every placeholder, and restrict it:
#   chmod 600 .env   (readable only by the user that runs gunicorn)
# Never commit the real file. Real environment variables (e.g. from systemd)
# take precedence over values in .env.
# The app refuses to start if a required value below is missing.
# Do not put comments on the same line as a value.

# ---------- Django core ----------
# Must stay 0 in production. Only the exact value 1 turns debug mode on.
DJANGO_DEBUG=0
# REQUIRED. Long random string, unique to this server. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# REQUIRED. Hostname(s) of this app, comma-separated, without https://.
DJANGO_ALLOWED_HOSTS=pos.example.com
# REQUIRED. The same hostname(s) WITH the https:// scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://pos.example.com
# 1 = nginx terminates HTTPS and sets X-Forwarded-Proto and X-Forwarded-For.
DJANGO_BEHIND_PROXY=1
# Path of the Django admin. Pick your own hard-to-guess value, ending in /.
DJANGO_ADMIN_URL=change-me-admin/
# HTTP Strict Transport Security. Keep 0 until HTTPS is confirmed working,
# then raise it (for example 3600 first, later 31536000 = one year).
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# nginx already redirects HTTP to HTTPS. Leave 0; 1 can cause redirect loops.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_LOG_LEVEL=INFO
# gunicorn listens on 127.0.0.1 at this port; nginx proxies to it.
GUNICORN_PORT=8765

# ---------- PostgreSQL (REQUIRED in production) ----------
DJANGO_DB_NAME=karim_pos
DJANGO_DB_USER=karim_pos
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ---------- Login lockout (django-axes) ----------
# Failed logins allowed per username + IP before a lockout, and its length.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# ---------- Business ----------
POS_CURRENCY=KES
POS_TIME_ZONE=Africa/Nairobi

# ---------- Shopify ----------
# Store domain only, e.g. your-store.myshopify.com (no https://).
SHOPIFY_STORE=
# Admin API access token. Never paste it anywhere else.
SHOPIFY_ACCESS_TOKEN=
# Keep 0 until the development-store validation is complete.
SHOPIFY_LIVE_SYNC=0
SHOPIFY_INVENTORY_BEHAVIOUR=DECREMENT_OBEYING_POLICY
