# Karim POS - LOCAL DEVELOPMENT environment. Copy to .env on your computer.
# Debug mode on, SQLite database, no Shopify connection.
# Do not put comments on the same line as a value.

DJANGO_DEBUG=1
# Optional locally. Blank = a private key is generated in .local-secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Blank = SQLite (db.sqlite3). Fill in the DJANGO_DB_* values to use a local PostgreSQL instead.
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

POS_CURRENCY=KES
POS_TIME_ZONE=Africa/Nairobi

SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LIVE_SYNC=0
SHOPIFY_INVENTORY_BEHAVIOUR=DECREMENT_OBEYING_POLICY
