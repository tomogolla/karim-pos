# Local development only. Set DEBUG=0 and DEMO_MODE=0 before deploying.
DJANGO_DEBUG=1
DEMO_MODE=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set a long random key for production. Development generates a private local key.
DJANGO_SECRET_KEY=
POS_CURRENCY=KES
POS_TIME_ZONE=Africa/Nairobi
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
# Disabled until development-store validation and business configuration are complete.
SHOPIFY_LIVE_SYNC=0
SHOPIFY_INVENTORY_BEHAVIOUR=DECREMENT_OBEYING_POLICY
